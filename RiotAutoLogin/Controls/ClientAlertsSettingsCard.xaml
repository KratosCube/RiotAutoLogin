<UserControl x:Class="RiotAutoLogin.Controls.ClientAlertsSettingsCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:RiotAutoLogin.Controls"
             MinHeight="0">
    <Border Style="{DynamicResource SettingsCardStyle}">
        <StackPanel>
            <TextBlock Text="Client Alerts"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextColorBrush}"/>
            <TextBlock Text="Choose the moments that should get your attention during champion select and game start."
                       Margin="0,6,0,16"
                       FontSize="13"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource MutedTextBrush}"/>

            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Game start"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextColorBrush}"/>
                    <TextBlock Text="Alert when the in-game timer reaches approximately 0:01."
                               Margin="0,4,12,0"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource MutedTextBrush}"/>
                </StackPanel>
                <ToggleButton x:Name="tglGameStartAlert"
                              x:FieldModifier="public"
                              Grid.Column="1"
                              Width="100"
                              Content="OFF"
                              Style="{DynamicResource ModernToggleButton}"/>
            </Grid>

            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Default game-start repeats"
                               FontSize="14"
                               Foreground="{DynamicResource TextColorBrush}"/>
                    <TextBlock Text="Used only for the built-in sound. A custom media file plays once. Range: 1–30."
                               Margin="0,4,12,0"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource MutedTextBrush}"/>
                </StackPanel>
                <TextBox x:Name="txtGameStartAlertRepeatCount"
                         x:FieldModifier="public"
                         Grid.Column="1"
                         Width="100"
                         Text="14"
                         HorizontalContentAlignment="Center"
                         Style="{DynamicResource ModernTextBox}"/>
            </Grid>

            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Your turn to pick"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextColorBrush}"/>
                    <TextBlock Text="Show an alert when your active champion-pick action begins."
                               Margin="0,4,12,0"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource MutedTextBrush}"/>
                </StackPanel>
                <ToggleButton x:Name="tglPickTurnAlert"
                              x:FieldModifier="public"
                              Grid.Column="1"
                              Width="100"
                              Content="OFF"
                              Style="{DynamicResource ModernToggleButton}"/>
            </Grid>

            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Flash side warning"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextColorBrush}"/>
                    <TextBlock Text="Warn when Flash is on the opposite summoner-spell slot."
                               Margin="0,4,12,0"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource MutedTextBrush}"/>
                </StackPanel>
                <ToggleButton x:Name="tglFlashSlotWarning"
                              x:FieldModifier="public"
                              Grid.Column="1"
                              Width="100"
                              Content="OFF"
                              Style="{DynamicResource ModernToggleButton}"/>
            </Grid>

            <Border Background="{DynamicResource SecondaryBackgroundBrush}"
                    CornerRadius="12"
                    Padding="14"
                    Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Preferred Flash slot"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextColorBrush}"/>
                    <TextBlock Text="Spell 1 is usually D and Spell 2 is usually F."
                               Margin="0,4,0,10"
                               FontSize="12"
                               Foreground="{DynamicResource MutedTextBrush}"/>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="rbFlashSlot1"
                                     x:FieldModifier="public"
                                     Content="Spell 1 / D"
                                     GroupName="PreferredFlashSlot"
                                     Margin="0,0,18,0"
                                     Foreground="{DynamicResource TextColorBrush}"
                                     FontSize="13"
                                     VerticalContentAlignment="Center"/>
                        <RadioButton x:Name="rbFlashSlot2"
                                     x:FieldModifier="public"
                                     Content="Spell 2 / F"
                                     GroupName="PreferredFlashSlot"
                                     Foreground="{DynamicResource TextColorBrush}"
                                     FontSize="13"
                                     VerticalContentAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource SecondaryBackgroundBrush}"
                    CornerRadius="12"
                    Padding="14">
                <StackPanel>
                    <TextBlock Text="Alert sounds"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextColorBrush}"/>
                    <TextBlock Text="Each alert can use a different MP4 or audio file. Choose Default to restore the built-in Windows sound."
                               Margin="0,4,0,8"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource MutedTextBrush}"/>

                    <local:AlertSoundPicker x:Name="gameStartSoundPicker"
                                            x:FieldModifier="public"
                                            AlertName="Game start"/>
                    <local:AlertSoundPicker x:Name="pickTurnSoundPicker"
                                            x:FieldModifier="public"
                                            AlertName="Your turn to pick"/>
                    <local:AlertSoundPicker x:Name="flashWarningSoundPicker"
                                            x:FieldModifier="public"
                                            AlertName="Flash warning"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
