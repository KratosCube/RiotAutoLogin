<Window x:Class="RiotAutoLogin.QuickLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:RiotAutoLogin.Converters"
        Title="Quick Login"
        Width="460"
        SizeToContent="Height"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        Opacity="0"
        UseLayoutRounding="True"
        FontFamily="Segoe UI Variable Text, Segoe UI">
    <Window.Resources>
        <conv:StringToImageSourceConverter x:Key="AvatarConverter"/>
        <conv:RankInfoConverter x:Key="RankConverter"/>
        <Style x:Key="AccountChoiceStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextColorBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,0,9"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Card"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="12,10">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="#161E29"/>
                                <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="{StaticResource ElevatedBackgroundBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CloseChoiceStyle" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="{StaticResource SecondaryBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextColorBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource ElevatedBackgroundBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="11">
        <Border Background="{StaticResource MainBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="20">
            <Border.Effect>
                <DropShadowEffect ShadowDepth="0" BlurRadius="18" Opacity="0.3"/>
            </Border.Effect>
            <Grid Margin="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{StaticResource CardBackgroundBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        CornerRadius="14" Padding="12" Margin="0,0,0,17">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="40" Height="40" CornerRadius="10"
                                Background="{StaticResource SecondaryBackgroundBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" Padding="5" Margin="0,0,12,0">
                            <Image Source="pack://application:,,,/resources/logoAcc.ico" Stretch="Uniform"/>
                        </Border>
                        <TextBlock Grid.Column="1" Text="Quick Login" FontSize="17" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextColorBrush}" VerticalAlignment="Center"/>
                        <Button Grid.Column="2" Style="{StaticResource CloseChoiceStyle}"
                                Click="Close_Click" ToolTip="Close" AutomationProperties.Name="Close quick login">
                            <Path Data="M0,0 L10,10 M0,10 L10,0" Stroke="{StaticResource TextColorBrush}"
                                  StrokeThickness="1.6" Width="12" Height="12" Stretch="Uniform"/>
                        </Button>
                    </Grid>
                </Border>

                <TextBlock Grid.Row="1" Text="Choose an account" FontSize="15" FontWeight="SemiBold"
                           Foreground="{StaticResource TextColorBrush}" Margin="3,0,0,12"/>

                <ScrollViewer x:Name="AccountScrollViewer" Grid.Row="2"
                              Style="{StaticResource DarkScrollViewerStyle}"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              CanContentScroll="False">
                    <ItemsControl x:Name="AccountList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Tag="{Binding}" Style="{StaticResource AccountChoiceStyle}"
                                        Click="Account_Click" AutomationProperties.Name="{Binding GameName}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="50" Height="50" CornerRadius="10"
                                                Background="{StaticResource SecondaryBackgroundBrush}"
                                                BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="1" Margin="0,0,12,0">
                                            <Grid>
                                                <TextBlock Text="●" Foreground="{StaticResource AccentBrush}"
                                                           FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <Image Source="{Binding AvatarPath, Converter={StaticResource AvatarConverter}}"
                                                       Stretch="UniformToFill"/>
                                            </Grid>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding GameName}" FontSize="14" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextColorBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock FontSize="11" Foreground="{StaticResource MutedTextBrush}"
                                                       TextTrimming="CharacterEllipsis" Margin="0,3,0,0">
                                                <Run Text="#"/><Run Text="{Binding TagLine}"/>
                                            </TextBlock>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="10,0,0,0"
                                                    HorizontalAlignment="Right">
                                            <Border CornerRadius="7" Background="{StaticResource SecondaryBackgroundBrush}"
                                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                    Padding="7,3" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding Region}" FontSize="10" FontWeight="SemiBold"
                                                           Foreground="{StaticResource MutedTextBrush}"/>
                                            </Border>
                                            <TextBlock Text="{Binding DisplayRankInfo, Converter={StaticResource RankConverter}}"
                                                       FontSize="10" Foreground="{StaticResource MutedTextBrush}"
                                                       HorizontalAlignment="Right" Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>
